{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>codeandsolder/ci-workflows:renovate-fleet"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/vendor/**",
    "archive/**",
    "results/**"
  ],
  "packageRules": [
    {
      "description": "Cranelift crates share public types and must be updated in lockstep",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "/^cranelift-/"
      ],
      "groupName": "Cranelift monorepo",
      "groupSlug": "cranelift-monorepo"
    }
  ]
}
